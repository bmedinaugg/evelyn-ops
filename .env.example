# Evelyn Ops — server-side environment. Copy to .env.local and fill in.
# NOTE: none of these are NEXT_PUBLIC_* — nothing here ships to the browser.

# Supabase project (schema `bot`)
SUPABASE_URL=https://rxnryvwpkdnwkpmhiiup.supabase.co

# Anon/publishable key — used ONLY for the staff auth (login/session) flow.
# It never queries bot.* data in this app.
SUPABASE_ANON_KEY=

# Service-role key — server-only. Used for ALL data access (the RPCs).
# Treat as a secret. Do not expose, do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Staff access control
# Any email at this domain may sign in.
STAFF_EMAIL_DOMAIN=urbangymgroup.com
# Optional: comma-separated explicit allow-list. If set, ONLY these emails may
# sign in (domain check still applies). Leave blank to allow the whole domain.
STAFF_ALLOWLIST=
# Optional: comma-separated named individuals, allowed whatever their mailbox
# domain. Use this for brand staff (TrainMore / High Studios) — they sign in
# with a @urbangymgroup.com Entra account, but Entra sends their @trainmore.nl
# mail address as the email claim, so STAFF_ALLOWLIST alone can't let them in.
STAFF_EXTRA_EMAILS=

# Anthropic API key — powers the AI fix suggestions on the Feedback inbox.
# Server-only. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Freshdesk (manual ticket creation from a conversation). API key from your
# Freshdesk profile settings. Server-only.
FRESHDESK_DOMAIN=urbangymgroup.freshdesk.com
FRESHDESK_API_KEY=

# n8n regression-test harness (Developer > Regression tests). Webhook URL of
# the isolated "Bot - Regression Test Harness" workflow, and the shared
# secret configured on its Webhook node's Header Auth credential
# (X-Harness-Secret). Server-only.
N8N_HARNESS_WEBHOOK_URL=
N8N_HARNESS_SECRET=
